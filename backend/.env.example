# Copy this file to .env and fill in real values before starting the API.

# REQUIRED: strong random secret for signing JWTs (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_hex_string

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kgpl_portal

# API server port
PORT=5000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# MongoDB (falls back to backend/data/nosql JSON files when the server is unavailable)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=kgpl_portal_nosql

# Google Gemini AI assistant (free API key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest